source("E:/Ovarian_cancer_pmct1/scripts/01_download_tcga_ov.R")
source("E:/Ovarian_cancer_pmct1/scripts/01_download_tcga_ov.R")
save.image(file = "scripts/session_backup.RData")
all_folders <- list.dirs(path =".", recursive = FASLE, full.names = FALSE)
all_folders <- list.dirs(path = ".", recursive = FALSE, full.names = FALSE)
